import cv2
import numpy as np
from scipy.optimize import least_squares
import matplotlib.pyplot as plt
import matplotlib.cm as cm
from matplotlib.colors import Normalize
from sklearn.cluster import KMeans

# Load and Preprocess the Image
image_path = r"semi_transparent (1)\semi_transparent\Bracquemond\louise-quivoron-aka-woman-in-the-garden-1877.jpg"
image = cv2.imread(image_path)
gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
blurred_image = cv2.GaussianBlur(gray_image, (5, 5), 0)

# Edge Detection and Contour Extraction
canny_edges = cv2.Canny(blurred_image, 100, 150)
contours, _ = cv2.findContours(canny_edges, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

def compute_normals_from_tangents(contour):
    """
    Computes the normals at each point in the contour (skipping the first and last points)
    by estimating the tangent using neighboring points.
    """
    normals = []
    for i in range(1, len(contour) - 1):
        p_prev = contour[i - 1][0]
        p_next = contour[i + 1][0]
        tangent = p_next - p_prev
        tangent_norm = np.linalg.norm(tangent)
        if tangent_norm > 0:
            normal = np.array([-tangent[1], tangent[0]]) / tangent_norm
            normals.append(normal)
    return normals

def sample_normals_and_intensities(contour, gray_image, normal_length=10):
    """
    For each contour, sample intensities along the normal.
    Returns a list of tuples: (point, normal, mean_intensity, weight, intensity_profile)
    where intensity_profile is a list of intensity values sampled along the normal,
    and 'weight' is computed as the mean of the absolute differences
    between consecutive intensity samples.
    """
    normals_and_intensities = []
    normals = compute_normals_from_tangents(contour)
    for i, normal in enumerate(normals):
        point = contour[i + 1][0]  # using the (i+1)th point
        x, y = point
        intensities = []
        # Sample intensities along the normal from -normal_length to +normal_length
        for d in range(-normal_length, normal_length + 1):
            sample_x = int(x + d * normal[0])
            sample_y = int(y + d * normal[1])
            if 0 <= sample_x < gray_image.shape[1] and 0 <= sample_y < gray_image.shape[0]:
                intensities.append(gray_image[sample_y, sample_x])
        if intensities:
            mean_intensity = np.mean(intensities)
            intensity_gradients = np.abs(np.diff(intensities))
            weight = np.mean(intensity_gradients)  # stronger gradients imply more reliable predictions
            normals_and_intensities.append((point, normal, mean_intensity, weight, intensities))
    return normals_and_intensities

def fit_reflectance_model_for_point(normal, intensity):
    """
    Fit a simple Lambertian reflectance model for a single point:
        I = rho * max(cos(theta), 0)
    where theta is the angle between the surface normal and the light direction.
    Negative cosines (light behind the surface) are clamped to 0.
    """
    def residuals(params):
        rho, theta = params
        # Compute the cosine between the normal and the light direction
        cos_theta = max(np.dot(normal, [np.cos(theta), np.sin(theta)]), 0)
        predicted_intensity = rho * cos_theta
        return predicted_intensity - intensity

    initial_guess = [1.0, 0.0]
    result = least_squares(residuals, initial_guess, bounds=([0, -np.pi], [np.inf, np.pi]))
    return result.x  # returns [rho, theta]

def get_intensity_profile(point, normal, gray_image, normal_length=10):
    """
    Returns the displacement values and corresponding intensity profile
    along the normal for a given point.
    """
    x, y = point
    displacements = list(range(-normal_length, normal_length + 1))
    intensities = []
    for d in displacements:
        sample_x = int(x + d * normal[0])
        sample_y = int(y + d * normal[1])
        if 0 <= sample_x < gray_image.shape[1] and 0 <= sample_y < gray_image.shape[0]:
            intensities.append(gray_image[sample_y, sample_x])
        else:
            intensities.append(np.nan)
    return displacements, intensities

# Process Each Contour to Estimate Illumination
point_results = []
for contour in contours:
    normals_info = sample_normals_and_intensities(contour, gray_image, normal_length=30)
    for info in normals_info:
        point, normal, mean_intensity, weight, intensity_profile = info
        # Fit the reflectance model using the mean intensity
        rho, theta = fit_reflectance_model_for_point(normal, mean_intensity)
        illumination_angle = np.degrees(theta)  # convert to degrees for interpretation
        point_results.append({
            "point": point,
            "normal": normal,
            "rho": rho,
            "theta": illumination_angle,  # stored in degrees
            "weight": weight,
            "intensity_profile": intensity_profile
        })

# Visualization of Predicted Angles with Colormap
angles = [result['theta'] for result in point_results]
if angles:
    min_angle = min(angles)
    max_angle = max(angles)
    print('Min and Max Angle:', min_angle, max_angle)
    norm_angles = [(angle - min_angle) / (max_angle - min_angle) for angle in angles]

    colormap = plt.colormaps["hsv"]
    output_image = image.copy()
    for result, norm_angle in zip(point_results, norm_angles):
        x, y = result['point']
        color = colormap(norm_angle)  # get an RGBA color from the colormap
        bgr_color = tuple(int(c * 255) for c in color[:3])
        cv2.circle(output_image, (x, y), 2, bgr_color, -1)

    rgb_image = cv2.cvtColor(output_image, cv2.COLOR_BGR2RGB)
    fig, ax = plt.subplots(figsize=(10, 8))
    ax.imshow(rgb_image)
    norm_obj = Normalize(vmin=min_angle, vmax=max_angle)
    scalar_mappable = cm.ScalarMappable(cmap=colormap, norm=norm_obj)
    scalar_mappable.set_array([])
    fig.colorbar(scalar_mappable, ax=ax, orientation="vertical", label="Illumination Angle (Degrees)")
    ax.set_title("Illumination Angles Visualized with Colors")
    ax.axis("off")
    plt.show()

    # Weighted Average of the Angles
    angles_arr = np.array(angles)
    weights_arr = np.array([result['weight'] for result in point_results])
    weighted_average_angle = np.sum(angles_arr * weights_arr) / np.sum(weights_arr)
    print(f"Weighted Average Illumination Angle: {weighted_average_angle:.2f}°")

    # Clustering Based on Angles with Sample Weights
    # (Filter out points with zero/invalid angles)
    filtered_point_results = [result for result in point_results if result['theta'] and result['theta'] != 0.0]
    if filtered_point_results:
        filtered_angles = [result['theta'] for result in filtered_point_results]
        angles_rad = np.radians(filtered_angles)
        X = np.column_stack([np.cos(angles_rad), np.sin(angles_rad)])
        filtered_weights = np.array([result['weight'] for result in filtered_point_results])

        # Weighted KMeans clustering (n_clusters=1)
        kmeans = KMeans(n_clusters=1, random_state=42).fit(X, sample_weight=filtered_weights)
        dominant_center = kmeans.cluster_centers_[0]
        dominant_angle = np.degrees(np.arctan2(dominant_center[1], dominant_center[0])) % 360

        # Visualization of Points Near Dominant Angle
        cluster_image = image.copy()
        angle_threshold = 25  # degrees; points within this threshold are considered close
        pred_angles = []
        for result in filtered_point_results:
            x, y = result['point']
            pred_angle = result['theta']
            pred_angles.append(pred_angle)
            angle_diff = min((pred_angle - dominant_angle) % 360, (dominant_angle - pred_angle) % 360)
            if angle_diff <= angle_threshold:
                cv2.circle(cluster_image, (x, y), 2, (0, 0, 255), -1)  # red for points close to dominant angle

        rgb_cluster_image = cv2.cvtColor(cluster_image, cv2.COLOR_BGR2RGB)
        plt.hist(pred_angles, bins=30, color='blue', alpha=0.7)
        plt.xlabel("Angle (degrees)")
        plt.ylabel("Frequency")
        plt.title("Distribution of Detected Angles (Filtered)")
        plt.show()

        fig, ax = plt.subplots(figsize=(10, 8))
        ax.imshow(rgb_cluster_image)
        ax.set_title(f"Points Close to Dominant Angle: {dominant_angle:.2f}°")
        ax.axis("off")
        plt.show()

        print(f"Dominant Angle: {dominant_angle:.2f}°")
        num_points_close = np.sum((np.abs(np.array(filtered_angles) - dominant_angle) <= angle_threshold))
        print(f"Number of points close to dominant angle: {num_points_close}")

        vis_image = image.copy()
        # Draw a large arrow from the center showing the dominant light source direction.
        h, w = image.shape[:2]
        center = (w // 2, h // 2)
        big_arrow_length = 100  # pixels
        dom_angle_rad = np.radians(dominant_angle)
        dom_dx = int(big_arrow_length * np.cos(dom_angle_rad))
        dom_dy = int(big_arrow_length * np.sin(dom_angle_rad))
        cv2.arrowedLine(vis_image, (center[0] + dom_dx, center[1] - dom_dy), center,
                        color=(0, 255, 0), thickness=3, tipLength=0.2)

        center_x = vis_image.shape[1] // 2  
        center_y = vis_image.shape[0] // 2  
        axis_color = (0, 255, 0)  # green color
        thickness = 2
        cv2.line(vis_image, (0, center_y), (vis_image.shape[1], center_y), axis_color, thickness)
        cv2.line(vis_image, (center_x, 0), (center_x, vis_image.shape[0]), axis_color, thickness)

        # Display the image
        cv2.imshow("Image with X and Y Axes and estimated light direction", vis_image)
        cv2.waitKey(0)
        cv2.destroyAllWindows()



    else:
        print("No valid non-zero angle points for clustering.")
else:
    print("No valid points to visualize.")
